#!name = 一嗨租车直连
#!desc = 一嗨租车专用直连；兼容 HTTPDNS 拦截器，放行一嗨实际使用的腾讯 HTTPDNS
#!author = SOLHK
#!system = iOS,iPadOS
#!type = normal

[General]
bypass-tun = 119.29.29.90/32,119.28.28.90/32,119.29.29.88/32,1hai.cn,*.1hai.cn,ehicar.com,*.ehicar.com,ehic.com.cn,*.ehic.com.cn,amap.com,*.amap.com,autonavi.com,*.autonavi.com
skip-proxy = 119.29.29.90/32,119.28.28.90/32,119.29.29.88/32,1hai.cn,*.1hai.cn,ehicar.com,*.ehicar.com,ehic.com.cn,*.ehic.com.cn,amap.com,*.amap.com,autonavi.com,*.autonavi.com
real-ip = 1hai.cn,*.1hai.cn,ehicar.com,*.ehicar.com,ehic.com.cn,*.ehic.com.cn,amap.com,*.amap.com,autonavi.com,*.autonavi.com

[Rule]
IP-CIDR,119.29.29.90/32,DIRECT,no-resolve
IP-CIDR,119.28.28.90/32,DIRECT,no-resolve
IP-CIDR,119.29.29.88/32,DIRECT,no-resolve
DOMAIN-SUFFIX,1hai.cn,DIRECT
DOMAIN-SUFFIX,ehicar.com,DIRECT
DOMAIN-SUFFIX,ehic.com.cn,DIRECT
DOMAIN-SUFFIX,amap.com,DIRECT
DOMAIN-SUFFIX,autonavi.com,DIRECT
DOMAIN-KEYWORD,1hai,DIRECT
DOMAIN-KEYWORD,ehai,DIRECT
