#!name = STRA 高德开屏抑制（测试版）
#!desc = 基于高德 17.01.0 实测抓包，只修改 AOCS 内三项开屏配置；不能保证清除本地缓存广告。
#!author = SOLHK
#!system = iOS,iPadOS
#!type = normal

[Script]
http-response ^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1(?:\?|$) script-path=https://straa.cn/amap-splash.js,requires-body=true,timeout=15,tag=STRA-高德开屏配置,enable=true

[Mitm]
hostname = m5.amap.com
